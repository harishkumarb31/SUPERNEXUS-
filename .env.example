# RegulaFlow AI Configuration
PORT=5000
NODE_ENV=development

# Database configuration (Defaults to zero-setup SQLite file in prisma/dev.db)
# For PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/regulaflow?schema=public"
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET="regulaflow-super-secret-jwt-key-sih-2026-production-grade"
JWT_EXPIRES_IN="7d"

# Document Storage & Limits
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=15728640

# LLM / AI Configuration (Groq / OpenAI / Local Grounded Fallback)
GROQ_API_KEY=""
AI_MODEL="llama-3.1-70b-versatile"
AI_PROVIDER="local-grounded"

# Client URL for CORS
CLIENT_URL="http://localhost:5173"

