// RegulaFlow AI Prisma Schema - PostgreSQL Production Target
// Smart India Hackathon 2026 - Problem Statement: SIH26262

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String
  fullName             String
  role                 String        // SUPER_ADMIN, ADMIN, DEPARTMENT_OFFICER, EVALUATOR, FRESHER, VIEWER, INSTITUTION_USER, etc.
  phone                String?
  designation          String?
  region               String?       // NORTHERN, WESTERN, SOUTHERN, EASTERN, CENTRAL, SOUTH_WESTERN
  departmentId         String?
  department           Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  institutionId        String?
  institution          Institution?  @relation(fields: [institutionId], references: [id])
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  assignedApplications Application[] @relation("AssignedOfficer")
  auditEvents          AuditEvent[]
  notifications        Notification[]
  findingsResolved     ValidationFinding[] @relation("ResolvedFindings")
  assignedTasks        UserTask[]    @relation("AssignedTo")
  createdTasks         UserTask[]    @relation("AssignedBy")

  // Enterprise Document & Request Relations
  uploadedDocuments    ApplicationDocument[] @relation("UploadedDocuments")
  documentVerifications DocumentVerification[] @relation("DocumentVerifications")
  uploadedVersions     DocumentVersion[]     @relation("UploadedVersions")
  createdDocRequests   DocumentRequest[]     @relation("CreatedDocRequests")
  assignedDocRequests  DocumentRequest[]     @relation("AssignedDocRequests")
  assignedByDocReq     DocumentRequestAssignment[] @relation("AssignedByDocReq")
  assignedToDocReq     DocumentRequestAssignment[] @relation("AssignedToDocReq")
  docAccessLogs        DocumentAccessLog[]   @relation("UserDocAccessLogs")
}

model Department {
  id              String        @id @default(uuid())
  name            String
  code            String        @unique
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users           User[]
  documents       ApplicationDocument[]
  documentRequests DocumentRequest[]
}

model UserTask {
  id              String        @id @default(uuid())
  title           String
  description     String?
  type            String        @default("VERIFICATION")
  status          String        @default("PENDING")
  priority        String        @default("NORMAL")
  progress        Int           @default(0)
  dueDate         DateTime?
  assignedToId    String
  assignedTo      User          @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById    String?
  assignedBy      User?         @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  applicationId   String?
  application     Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  documents       ApplicationDocument[] @relation("TaskDocuments")
  documentRequests DocumentRequest[]     @relation("TaskDocRequests")
}

model Institution {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  type            String
  region          String
  state           String
  city            String
  address         String
  pincode         String
  contactEmail    String
  contactPhone    String
  establishedYear Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users           User[]
  applications    Application[]
  complianceItems ComplianceObligation[]
  notifications   Notification[]
  documents       ApplicationDocument[]
}

model Application {
  id                  String        @id @default(uuid())
  applicationNumber   String        @unique
  academicYear        String        @default("2026-2027")
  category            String
  currentStage        String        @default("DRAFT")
  priority            String        @default("NORMAL")
  institutionId       String
  institution         Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignedOfficerId   String?
  assignedOfficer     User?         @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  submissionDate      DateTime?
  deadlineDate        DateTime?
  lastResubmissionDate DateTime?
  programmesData      String?
  infrastructureData  String?
  facultyData         String?
  financialData       String?
  scrutinyRemarks     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  documents           ApplicationDocument[]
  findings            ValidationFinding[]
  complianceItems     ComplianceObligation[]
  evcActivities       EVCActivity[]
  stageHistory        ApplicationStageHistory[]
  notifications       Notification[]
  tasks               UserTask[]
  documentRequests    DocumentRequest[]
}

model DocumentCategory {
  id              String        @id @default(uuid())
  name            String        @unique
  code            String        @unique
  description     String?
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  documents       ApplicationDocument[]
  requests        DocumentRequest[]
}

model ApplicationDocument {
  id                  String              @id @default(uuid())
  applicationId       String?
  application         Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType        String
  title               String?
  description         String?
  fileName            String
  originalName        String
  mimeType            String
  fileSize            Int
  filePath            String
  checksumSha256      String
  version             Int                 @default(1)
  uploadDate          DateTime            @default(now())
  expiryDate          DateTime?
  status              String              @default("PENDING_VERIFICATION")
  rejectionReason     String?
  verifiedBy          String?
  verifiedAt          DateTime?

  categoryId          String?
  category            DocumentCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  departmentId        String?
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploaderId          String?
  uploader            User?               @relation("UploadedDocuments", fields: [uploaderId], references: [id], onDelete: SetNull)
  institutionId       String?
  institution         Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  taskId              String?
  task                UserTask?           @relation("TaskDocuments", fields: [taskId], references: [id], onDelete: SetNull)

  isRestricted        Boolean             @default(false)
  allowedUserIds      String?

  extractions         DocumentExtraction[]
  findings            ValidationFinding[]
  complianceItems     ComplianceObligation[]
  verifications       DocumentVerification[]
  versions            DocumentVersion[]
  accessLogs          DocumentAccessLog[]
  fulfilledRequests   DocumentRequest[]   @relation("FulfilledDoc")
}

model DocumentVerification {
  id              String              @id @default(uuid())
  documentId      String
  document        ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifierId      String
  verifier        User                @relation("DocumentVerifications", fields: [verifierId], references: [id], onDelete: Cascade)
  status          String
  comments        String?
  rejectionReason String?
  createdAt       DateTime            @default(now())
}

model DocumentVersion {
  id              String              @id @default(uuid())
  documentId      String
  document        ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber   Int
  fileName        String
  originalName    String
  filePath        String
  fileSize        Int
  checksumSha256  String
  uploadedById    String?
  uploadedBy      User?               @relation("UploadedVersions", fields: [uploadedById], references: [id], onDelete: SetNull)
  changeSummary   String?
  createdAt       DateTime            @default(now())
}

model DocumentRequest {
  id                  String                    @id @default(uuid())
  requestNumber       String                    @unique
  title               String
  categoryId          String?
  category            DocumentCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName        String?
  description         String?
  reason              String
  priority            String                    @default("NORMAL")
  requiredByDate      DateTime?
  status              String                    @default("SUBMITTED")
  requesterId         String
  requester           User                      @relation("CreatedDocRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedToId        String?
  assignedTo          User?                     @relation("AssignedDocRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  departmentId        String?
  department          Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  applicationId       String?
  application         Application?              @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  taskId              String?
  task                UserTask?                 @relation("TaskDocRequests", fields: [taskId], references: [id], onDelete: SetNull)
  fulfilledDocumentId String?
  fulfilledDocument   ApplicationDocument?      @relation("FulfilledDoc", fields: [fulfilledDocumentId], references: [id], onDelete: SetNull)
  rejectionReason     String?
  clarificationNotes  String?
  assignments         DocumentRequestAssignment[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model DocumentRequestAssignment {
  id              String          @id @default(uuid())
  requestId       String
  request         DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignedById    String?
  assignedBy      User?           @relation("AssignedByDocReq", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedToId    String
  assignedTo      User            @relation("AssignedToDocReq", fields: [assignedToId], references: [id], onDelete: Cascade)
  notes           String?
  timestamp       DateTime        @default(now())
}

model DocumentAccessLog {
  id              String              @id @default(uuid())
  documentId      String
  document        ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId          String
  user            User                @relation("UserDocAccessLogs", fields: [userId], references: [id], onDelete: Cascade)
  action          String
  ipAddress       String?
  userAgent       String?
  timestamp       DateTime            @default(now())
}

model DocumentExtraction {
  id                  String              @id @default(uuid())
  documentId          String
  document            ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rawText             String
  extractedFieldsJson String?
  confidenceScore     Float               @default(0.0)
  ocrEngine           String              @default("TESSERACT_OCR")
  processedAt         DateTime            @default(now())
}

model ValidationFinding {
  id                  String              @id @default(uuid())
  applicationId       String
  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId          String?
  document            ApplicationDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  ruleCode            String
  title               String
  description         String
  severity            String
  status              String              @default("OPEN")
  evidenceExcerpt     String?
  detectedAt          DateTime            @default(now())
  resolvedByUserId    String?
  resolvedByUser      User?               @relation("ResolvedFindings", fields: [resolvedByUserId], references: [id])
  resolutionNotes     String?
  resolutionDate      DateTime?
}

model ComplianceObligation {
  id                  String              @id @default(uuid())
  institutionId       String
  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applicationId       String?
  application         Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  obligationType      String
  title               String
  description         String
  dueDate             DateTime
  warningDays         Int                 @default(30)
  status              String              @default("ACTIVE")
  evidenceDocumentId  String?
  evidenceDocument    ApplicationDocument? @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  completedAt         DateTime?
  completionNotes     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model EVCActivity {
  id                  String              @id @default(uuid())
  applicationId       String
  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  committeeType       String              @default("EXPERT_VISITING_COMMITTEE")
  scheduledDate       DateTime
  venueOrMode         String              @default("PHYSICAL_INSPECTION")
  status              String              @default("SCHEDULED")
  chairmanName        String
  membersJson         String
  checklistJson       String?
  observations        String?
  recommendation      String?
  reportDocumentPath  String?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model ApplicationStageHistory {
  id                  String              @id @default(uuid())
  applicationId       String
  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage           String
  toStage             String
  action              String
  actorId             String?
  actorName           String?
  actorRole           String?
  reason              String?
  timestamp           DateTime            @default(now())
}

model Notification {
  id                  String              @id @default(uuid())
  userId              String?
  user                User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId       String?
  institution         Institution?        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applicationId       String?
  application         Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentRequestId   String?
  category            String
  severity            String              @default("INFO")
  title               String
  message             String
  link                String?
  read                Boolean             @default(false)
  metadataJson        String?
  createdAt           DateTime            @default(now())
}

model EscalationEvent {
  id                  String              @id @default(uuid())
  applicationId       String?
  complianceId        String?
  triggerRule         String
  severity            String              @default("HIGH")
  escalatedToRole     String
  message             String
  resolved            Boolean             @default(false)
  createdAt           DateTime            @default(now())
  resolvedAt          DateTime?
}

model RegulatoryReference {
  id                  String              @id @default(uuid())
  code                String              @unique
  title               String
  chapter             String
  category            String
  summary             String
  contentChunksJson   String
  effectiveYear       String              @default("2026-2027")
  createdAt           DateTime            @default(now())
}

model AuditEvent {
  id                  String              @id @default(uuid())
  actorId             String?
  user                User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail          String
  actorRole           String
  action              String
  entityType          String
  entityId            String?
  beforeStateJson     String?
  afterStateJson      String?
  reason              String?
  ipAddress           String?
  userAgent           String?
  timestamp           DateTime            @default(now())
}
